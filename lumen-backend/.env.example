# Lumen backend — environment variable template.
# Copy to .env for local development. Never commit an actual .env file.
# No production credentials belong in this repository at any point.

# Postgres connection string used by drizzle-kit and the app's db client.
DATABASE_URL=postgresql://lumen:lumen@localhost:5432/lumen_dev

# Reserved for the TTS provider credential (Real TTS / Narration Execution workstream).
# ELEVENLABS_API_KEY is optional -- present, main.ts registers a real ElevenLabsProvider
# at startup; absent, the ProviderRegistry stays exactly as empty as it was before that
# workstream, and narration honestly fails NO_ELIGIBLE_PROVIDER rather than fabricating
# capability. No real value has ever existed in this environment -- confirmed by
# repository-wide search at the start of every workstream that has touched this area.
# ELEVENLABS_API_KEY=
